{
  "name": "WhatsApp-Botto-AKURA",
  "description": "AKURA modular WhatsApp bot",
  "keywords": [
    "bot",
    "whatsapp",
    "stickers",
    "whatsapp-stickers",
    "anime",
    "whatsapp-bot",
    "whatsapp-sticker-bot",
    "whatsapp-botto",
    "akura"
  ],
  "website": "https://github.com/livesabeditor/Whatsapp-Botto-AKURA#readme",
  "repository": "https://github.com/livesabeditor/Whatsapp-Botto-AKURA.git",
  "success_url": "/",
  "env": {
    "NAME": {
      "description": "Bot display name",
      "value": "AKURA"
    },
    "PREFIX": {
      "description": "Command prefix",
      "value": "."
    },
    "SESSION": {
      "description": "Private session identifier for the bot",
      "value": "AKURA"
    },
    "OWNER_NUMBER": {
      "description": "Private owner phone number in international format without +",
      "required": false
    },
    "MODS": {
      "description": "Additional moderator numbers in international format without +, comma-separated",
      "required": false
    },
    "CRON": {
      "description": "Cron string to clear chats in a cycle",
      "required": false
    },
    "MONGO_URI": {
      "description": "MongoDB connection URI (required)",
      "required": true
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "https://github.com/PrajjwalDatir/heroku-buildpack-imagemagick.git"
    },
    {
      "url": "https://github.com/clhuang/heroku-buildpack-webp-binaries.git"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    }
  ]
}
